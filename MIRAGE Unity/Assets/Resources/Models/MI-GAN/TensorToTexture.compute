#pragma kernel CSMain

// Input buffer containing tensor data in NCHW format
RWStructuredBuffer<int> InputTensor;
// Output texture
RWTexture2D<float4> Result;

// Tensor dimensions
uint Width;
uint Height;
uint Channels;
uint BatchSize;

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    // Early exit if outside texture dimensions
    if (id.x >= Width || id.y >= Height)
        return;

    float4 color = float4(0, 0, 0, 1); // Default alpha to 1

    // Calculate the base index for this pixel in NCHW format
    // Flip Y coordinate by using (Height - 1 - id.y)
    // Index = c * (Height * Width) + y * Width + x
    uint pixelOffset = (Height - 1 - id.y) * Width + id.x;
    uint planeSize = Height * Width;
    if (Channels > 0) color.r = InputTensor[pixelOffset] / 255.0f;
    if (Channels > 1) color.g = InputTensor[planeSize + pixelOffset] / 255.0f;
    if (Channels > 2) color.b = InputTensor[2 * planeSize + pixelOffset] / 255.0f;

    Result[id.xy] = color;
} 