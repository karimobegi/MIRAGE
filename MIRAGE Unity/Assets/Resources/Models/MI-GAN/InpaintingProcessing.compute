#pragma kernel DilateHorizontal
#pragma kernel DilateVertical
#pragma kernel FeatherHorizontal
#pragma kernel FeatherVertical
#pragma kernel PrepareCrop
#pragma kernel CompositeCrop
#pragma kernel EstimateMotion
#pragma kernel ResetReuseStats
#pragma kernel WarpHistory

Texture2D<float> MaskSource;
Texture2D<float> OriginalMask;
RWTexture2D<float> MaskResult;
int Width;
int Height;
int Radius;
SamplerState sampler_linear_clamp;
SamplerState sampler_point_clamp;

float ReadMask(int2 p)
{
    if (p.x < 0 || p.y < 0 || p.x >= Width || p.y >= Height) return 0;
    return MaskSource.Load(int3(p, 0));
}

[numthreads(8,8,1)]
void DilateHorizontal(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)Width || id.y >= (uint)Height) return;
    float value = 0;
    for (int dx = -Radius; dx <= Radius; dx++) value = max(value, ReadMask(int2(id.xy) + int2(dx, 0)));
    MaskResult[id.xy] = value;
}

[numthreads(8,8,1)]
void DilateVertical(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)Width || id.y >= (uint)Height) return;
    float value = 0;
    for (int dy = -Radius; dy <= Radius; dy++) value = max(value, ReadMask(int2(id.xy) + int2(0, dy)));
    MaskResult[id.xy] = value;
}

[numthreads(8,8,1)]
void FeatherHorizontal(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)Width || id.y >= (uint)Height) return;
    float value = 0;
    for (int dx = -Radius; dx <= Radius; dx++) value += ReadMask(int2(id.xy) + int2(dx, 0));
    MaskResult[id.xy] = value / (2 * Radius + 1);
}

[numthreads(8,8,1)]
void FeatherVertical(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)Width || id.y >= (uint)Height) return;
    float value = 0;
    for (int dy = -Radius; dy <= Radius; dy++) value += ReadMask(int2(id.xy) + int2(0, dy));
    // Preserve an opaque original silhouette; only the expanded edge fades.
    MaskResult[id.xy] = max(OriginalMask.Load(int3(id.xy, 0)), value / (2 * Radius + 1));
}

Texture2D<float4> Frame;
Texture2D<float> AlphaMask;
Texture2D<float4> CropResult;
RWTexture2D<float4> Overlay;
RWStructuredBuffer<float> ImageTensor;
RWStructuredBuffer<float> HoleTensor;
float4 CropRect; // normalized bottom-left x,y,width,height; may extend outside frame
int ModelWidth;
int ModelHeight;
int InputIsLinear;

float3 LinearToSRGB(float3 color)
{
    color = max(color, 0);
    return lerp(12.92 * color, 1.055 * pow(color, 1.0 / 2.4) - 0.055, step(0.0031308, color));
}

float3 SRGBToLinear(float3 color)
{
    color = saturate(color);
    return lerp(color / 12.92, pow((color + 0.055) / 1.055, 2.4), step(0.04045, color));
}

[numthreads(8,8,1)]
void PrepareCrop(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)ModelWidth || id.y >= (uint)ModelHeight) return;
    // Tensor row zero is the top row; texture row zero is the bottom row.
    float2 local = float2((id.x + 0.5) / ModelWidth, 1.0 - (id.y + 0.5) / ModelHeight);
    float2 uv = CropRect.xy + local * CropRect.zw;
    float3 rgb = Frame.SampleLevel(sampler_linear_clamp, uv, 0).rgb;
    // Model checkpoints were trained on ordinary sRGB images, while camera
    // sampling and compositing in a Linear Unity project use linear light.
    if (InputIsLinear != 0) rgb = LinearToSRGB(rgb);
    bool inside = all(uv >= 0) && all(uv <= 1);
    float alpha = inside ? AlphaMask.SampleLevel(sampler_linear_clamp, uv, 0) : 0;
    uint index = id.y * ModelWidth + id.x;
    uint plane = ModelWidth * ModelHeight;
    ImageTensor[index] = rgb.r;
    ImageTensor[plane + index] = rgb.g;
    ImageTensor[2 * plane + index] = rgb.b;
    HoleTensor[index] = alpha > 0.0001 ? 1.0 : 0.0;
}

[numthreads(8,8,1)]
void CompositeCrop(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)Width || id.y >= (uint)Height) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(Width, Height);
    float2 local = (uv - CropRect.xy) / CropRect.zw;
    if (any(local < 0) || any(local > 1)) return;
    float alpha = AlphaMask.SampleLevel(sampler_linear_clamp, uv, 0);
    if (alpha <= 0.0001) return;
    float3 rgb = CropResult.SampleLevel(sampler_linear_clamp, local, 0).rgb;
    if (InputIsLinear != 0) rgb = SRGBToLinear(rgb);
    Overlay[id.xy] = float4(saturate(rgb), alpha);
}

Texture2D<float4> PreviousFrame;
Texture2D<float4> PreviousOverlay;
Texture2D<float> PreviousMask;
RWTexture2D<float4> FlowResult;
Texture2D<float4> Flow;
RWTexture2D<float4> WarpedOverlay;
RWStructuredBuffer<uint> ReuseStats; // target pixels, rejected target pixels
int MotionWidth;
int MotionHeight;
int FlowWidth;
int FlowHeight;
int SearchRadius;
float MaxPhotometricError;
float MinMotionUniqueness;

float4 SampleHistory(float2 uv)
{
    // The public overlay is straight-alpha. Interpolate cached edges in
    // associated colour and unassociate afterwards to avoid dark fringes from
    // transparent black texels when motion lands between source pixels.
    float2 position = uv * float2(Width, Height) - 0.5;
    int2 origin = int2(floor(position));
    float2 fraction = frac(position);
    float3 associated = 0;
    float alpha = 0;
    for (int y = 0; y <= 1; y++)
    for (int x = 0; x <= 1; x++)
    {
        int2 p = clamp(origin + int2(x, y), int2(0, 0), int2(Width - 1, Height - 1));
        float4 sample = PreviousOverlay.Load(int3(p, 0));
        float weight = (x == 0 ? 1 - fraction.x : fraction.x) * (y == 0 ? 1 - fraction.y : fraction.y);
        associated += sample.rgb * sample.a * weight;
        alpha += sample.a * weight;
    }
    return float4(associated / max(alpha, 0.000001), alpha);
}

// Backward block matching on visible background. The removed foreground's
// colour is deliberately excluded from the background motion estimate.
[numthreads(8,8,1)]
void EstimateMotion(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)FlowWidth || id.y >= (uint)FlowHeight) return;
    float2 centre = (float2(id.xy) + 0.5) / float2(FlowWidth, FlowHeight);
    float2 stepUV = 1.0 / float2(MotionWidth, MotionHeight);
    float bestError = 1000;
    float secondError = 1000;
    int2 bestOffset = 0;
    int bestSamples = 0;
    for (int dy = -SearchRadius; dy <= SearchRadius; dy++)
    for (int dx = -SearchRadius; dx <= SearchRadius; dx++)
    {
        float error = 0;
        int samples = 0;
        float2 offset = float2(dx, dy) * stepUV;
        for (int py = -4; py <= 4; py += 2)
        for (int px = -4; px <= 4; px += 2)
        {
            float2 currentUV = centre + float2(px, py) * stepUV;
            float2 previousUV = currentUV + offset;
            if (any(currentUV <= 0) || any(currentUV >= 1) || any(previousUV <= 0) || any(previousUV >= 1)) continue;
            if (AlphaMask.SampleLevel(sampler_point_clamp, currentUV, 0) > 0.001 ||
                PreviousMask.SampleLevel(sampler_point_clamp, previousUV, 0) > 0.001) continue;
            float3 a = Frame.SampleLevel(sampler_linear_clamp, currentUV, 0).rgb;
            float3 b = PreviousFrame.SampleLevel(sampler_linear_clamp, previousUV, 0).rgb;
            error += dot(abs(a - b), float3(0.333333, 0.333333, 0.333333));
            samples++;
        }
        if (samples < 8) continue;
        error /= samples;
        bool lowerMotionTie = abs(error - bestError) < 0.0000001 &&
            dx * dx + dy * dy < dot(bestOffset, bestOffset);
        if (error < bestError || lowerMotionTie)
        {
            secondError = bestError;
            bestError = error;
            bestOffset = int2(dx, dy);
            bestSamples = samples;
        }
        else secondError = min(secondError, error);
    }
    bool interior = abs(bestOffset.x) < SearchRadius && abs(bestOffset.y) < SearchRadius;
    bool unique = secondError - bestError >= MinMotionUniqueness;
    bool unchanged = all(bestOffset == int2(0, 0)) && bestError < 0.00001;
    bool valid = bestSamples >= 8 && bestError <= MaxPhotometricError && interior && (unique || unchanged);
    FlowResult[id.xy] = float4(float2(bestOffset) * stepUV, bestError, valid ? 1 : 0);
}

[numthreads(1,1,1)]
void ResetReuseStats(uint3 id : SV_DispatchThreadID)
{
    ReuseStats[0] = 0;
    ReuseStats[1] = 0;
}

[numthreads(8,8,1)]
void WarpHistory(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)Width || id.y >= (uint)Height) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(Width, Height);
    float alpha = AlphaMask.SampleLevel(sampler_linear_clamp, uv, 0);
    WarpedOverlay[id.xy] = 0;
    if (alpha <= 0.0001) return;
    InterlockedAdd(ReuseStats[0], 1);
    float4 motion = Flow.SampleLevel(sampler_point_clamp, uv, 0);
    float2 previousUV = uv + motion.xy;
    bool valid = motion.w > 0.5 && all(previousUV > 0) && all(previousUV < 1);
    float4 previous = SampleHistory(previousUV);
    // Reject newly uncovered pixels/mask changes instead of extending cached fill.
    valid = valid && previous.a > 0.0001 && previous.a + 0.015 >= alpha;
    if (!valid)
    {
        InterlockedAdd(ReuseStats[1], 1);
        return;
    }
    WarpedOverlay[id.xy] = float4(previous.rgb, alpha);
}
