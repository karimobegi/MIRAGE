#pragma kernel ObjectDepthPartial
#pragma kernel ObjectDepthFinalize

StructuredBuffer<int2> SegmentationBuffer;
StructuredBuffer<float> DepthBuffer;
// One independently written record per tile/object: interior sum/count, full sum/count.
RWStructuredBuffer<float4> PartialDepths;
RWStructuredBuffer<float> ObjectDepthBuffer;
uint ImageWidth, ImageHeight, GroupsX, TileCount, ObjectCapacity, NumObjects;
float DepthScale, DepthOffset, MaximumValidDepth;
groupshared int tileObjects[64];
groupshared float tileDepths[64];
groupshared uint tileInterior[64];

bool IsInterior(uint2 pixel, int objectId)
{
    // One-pixel cross erosion rejects uncertain segmentation boundaries.
    if (pixel.x == 0 || pixel.y == 0 || pixel.x + 1 >= ImageWidth || pixel.y + 1 >= ImageHeight)
        return false;
    uint index = pixel.y * ImageWidth + pixel.x;
    return SegmentationBuffer[index - 1].x == objectId
        && SegmentationBuffer[index + 1].x == objectId
        && SegmentationBuffer[index - ImageWidth].x == objectId
        && SegmentationBuffer[index + ImageWidth].x == objectId;
}

[numthreads(8, 8, 1)]
void ObjectDepthPartial(uint3 id : SV_DispatchThreadID, uint3 groupId : SV_GroupID, uint3 localId : SV_GroupThreadID)
{
    uint lane = localId.y * 8 + localId.x;
    uint tileOffset = (groupId.y * GroupsX + groupId.x) * ObjectCapacity;
    // Clear this tile only. No workgroup scans/writes another tile's pixels.
    for (uint obj = lane; obj < NumObjects; obj += 64)
        PartialDepths[tileOffset + obj] = 0;

    int objectId = -1;
    float depth = 0;
    uint interior = 0;
    if (id.x < ImageWidth && id.y < ImageHeight)
    {
        uint index = id.y * ImageWidth + id.x;
        int candidate = SegmentationBuffer[index].x;
        float candidateDepth = DepthBuffer[index];
        if (candidate >= 0 && candidate < (int)NumObjects && isfinite(candidateDepth)
            && candidateDepth > 0 && candidateDepth <= MaximumValidDepth)
        {
            objectId = candidate;
            depth = candidateDepth;
            interior = IsInterior(id.xy, objectId) ? 1 : 0;
        }
    }
    tileObjects[lane] = objectId;
    tileDepths[lane] = depth;
    tileInterior[lane] = interior;
    AllMemoryBarrierWithGroupSync();
    if (objectId < 0)
        return;
    // First lane for an object owns its tile record: no float atomics/racing writes.
    for (uint previous = 0; previous < lane; previous++)
        if (tileObjects[previous] == objectId)
            return;
    float4 sums = 0;
    for (uint other = 0; other < 64; other++)
    {
        if (tileObjects[other] != objectId)
            continue;
        sums.z += tileDepths[other];
        sums.w += 1;
        if (tileInterior[other] != 0)
        {
            sums.x += tileDepths[other];
            sums.y += 1;
        }
    }
    PartialDepths[tileOffset + objectId] = sums;
}

[numthreads(64, 1, 1)]
void ObjectDepthFinalize(uint3 id : SV_DispatchThreadID)
{
    uint objectId = id.x;
    if (objectId >= ObjectCapacity)
        return;
    // NaN fails range comparisons and cannot masquerade as zero metres.
    float invalidDepth = asfloat(0x7FC00000u);
    if (objectId >= NumObjects)
    {
        ObjectDepthBuffer[objectId] = invalidDepth;
        return;
    }
    float4 sums = 0;
    for (uint tile = 0; tile < TileCount; tile++)
        sums += PartialDepths[tile * ObjectCapacity + objectId];
    // Interior mean reduces edge contamination; thin objects use full-mask mean.
    float count = sums.y > 0 ? sums.y : sums.w;
    float total = sums.y > 0 ? sums.x : sums.z;
    float depth = count > 0 ? (total / count) * DepthScale + DepthOffset : invalidDepth;
    ObjectDepthBuffer[objectId] = isfinite(depth) && depth > 0 ? depth : invalidDepth;
}
